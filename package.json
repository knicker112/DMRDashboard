{
  "name": "dmr-dashboard",
  "private": true,
  "version": "1.1.29",
  "description": "BrandMeister DMR Hotspot Dashboard für Funkamateure",
  "author": "Christian Schmitz DO2EF",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/check-radioid.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "update-callsigns": "node scripts/fetch-callsigns.mjs",
    "update-radioid": "node scripts/fetch-radioid.mjs",
    "update-talkgroups": "node scripts/fetch-talkgroups.mjs",
    "electron:dev": "vite build && electron .",
    "electron:build:linux": "vite build && electron-builder --linux AppImage --publish never",
    "electron:build:win": "vite build && electron-builder --win nsis --publish never",
    "electron:build:all": "vite build && electron-builder --linux AppImage --win nsis --publish never"
  },
  "build": {
    "appId": "de.do2ef.dmr-dashboard",
    "productName": "DMR Dashboard",
    "copyright": "© 2026 Christian Schmitz DO2EF",
    "extraMetadata": {
      "type": "commonjs"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "HamRadio",
      "artifactName": "DMR-Dashboard-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico",
      "artifactName": "DMR-Dashboard-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "language": "1031"
    },
    "publish": {
      "provider": "generic",
      "url": "https://raw.githubusercontent.com/knicker112/DMRDashboard/master/updates/"
    }
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "electron-updater": "^6.8.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
